PORT=4000
# Comma-separated list of exact frontend origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so rate limits see real IPs
TRUST_PROXY=0

# Supabase. The SERVICE ROLE key is server-only: never put it in the client or in git.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY

# Link included in the WhatsApp credentials message
APP_LOGIN_URL=http://localhost:5173/login

# Optional push notifications (OneSignal). The REST key is server-only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Attendance rules
APP_TIMEZONE=Africa/Freetown
GPS_MAX_ACCURACY_METERS=60
ATTENDANCE_GRACE_MINUTES=10

# Security
TEMP_PASSWORD_HOURS=48
LOGIN_LOCK_MINUTES=15

# Absent marking. The server runs it every 5 minutes by itself; set AUTO_FINALIZE=false
# if you prefer an external cron calling POST /api/jobs/finalize-attendance with x-job-secret.
AUTO_FINALIZE=true
ATTENDANCE_JOB_SECRET=replace-with-a-long-random-secret

# QR Code Attendance Signing Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=replace_with_a_64_character_random_hex_string
